# ─── Firebase Web SDK (frontend — VITE_ prefix required) ────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─── Firebase Admin SDK (server-side only — do NOT use VITE_ prefix) ─────────
# Paste the full service-account JSON object as a single-line string in Vercel.
# Never commit this value to source control.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ─── EmailJS (server-side only — do NOT use VITE_ prefix) ────────────────────
EMAILJS_SERVICE_ID=service_fh994ax
EMAILJS_TEMPLATE_ID=template_1p9m2hk
EMAILJS_PUBLIC_KEY=zkuJvLPBhjKyrokx-
# Your EmailJS private key — used as the API access token (accessToken).
# Never expose this in frontend code or commit it to GitHub.
EMAILJS_PRIVATE_KEY=

# ─── Rate Limiting (server-side only) ────────────────────────────────────────
# A random secret used as the HMAC-SHA256 key for email hashing.
# Generate with:  openssl rand -hex 32
RATE_LIMIT_SECRET=

# ─── Admin Access (server-side only) ─────────────────────────────────────────
# Comma-separated list of administrator Gmail addresses (case-insensitive).
# Example: admin@gmail.com
# Never expose this in frontend code.
ADMIN_EMAILS=

# ─── Public Application URL ───────────────────────────────────────────────────
PUBLIC_APP_URL=https://kcet-password-reset.vercel.app
